aws_region = "ap-northeast-2"
env        = "dev"

# S3 bucket names must be globally unique.
# Example:
# bucket_name = "clueroom-assets-yourname-20260520"
bucket_name = "clueroom-assets-change-me"

allowed_origins = [
  "https://api.clueroom.xyz",
  "https://clueroom.xyz",
  "http://localhost:3000",
  "http://localhost:5173"
]
