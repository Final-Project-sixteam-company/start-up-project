# Copy this file to .env for local overrides.
# Do not commit the real .env file.

# -----------------------------------------------------------------------------
# Server / Spring
# -----------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
LOG_LEVEL_ROOT=info
LOG_LEVEL_APP=debug

# -----------------------------------------------------------------------------
# Local H2
# -----------------------------------------------------------------------------
LOCAL_DB_URL=jdbc:h2:mem:startup;MODE=MySQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
LOCAL_DB_USERNAME=sa
LOCAL_DB_PASSWORD=
JPA_DDL_AUTO=create-drop

# -----------------------------------------------------------------------------
# MySQL, mainly for prod profile
# -----------------------------------------------------------------------------
# Docker Compose에서는 DB_HOST를 직접 바꾸지 않아도 app 컨테이너가 mysql 서비스명을 사용한다.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=startup
DB_USERNAME=root
DB_PASSWORD=12345678
MYSQL_HOST_PORT=33306
DOCKER_JPA_DDL_AUTO=update

# -----------------------------------------------------------------------------
# Redis / Redisson
# -----------------------------------------------------------------------------
# REDIS_PASSWORD를 비우면 로컬 Redis도 비밀번호 없이 실행된다.
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_HOST_PORT=16379
REDIS_PASSWORD=
REDIS_TIMEOUT=2s
REDIS_POOL_MAX_ACTIVE=8
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=1

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
# Grafana 기본 계정은 로컬 개발용이다. 외부 공개 환경에서는 반드시 바꾼다.
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# Spring AI / OpenAI
# -----------------------------------------------------------------------------
# none:
#   App boots without an AI provider or API key.
# openai:
#   Enables Spring AI OpenAI ChatModel. OPENAI_API_KEY is required.
SPRING_AI_MODEL_CHAT=none
SPRING_AI_MODEL_EMBEDDING=none
SPRING_AI_MODEL_IMAGE=none
SPRING_AI_MODEL_MODERATION=none
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_TEMPERATURE=0.4

# -----------------------------------------------------------------------------
# AWS S3
# -----------------------------------------------------------------------------
# AWS credentials are server secrets. Do not put them in Android.
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# Firebase Cloud Messaging
# -----------------------------------------------------------------------------
# Service account JSON is a server secret. Do not commit the real JSON file.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=
# Docker Compose mounts this host directory to /opt/caselab/secrets as read-only.
SECRETS_HOST_DIR=./secrets

# -----------------------------------------------------------------------------
# Multipart
# -----------------------------------------------------------------------------
MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=12MB

# -----------------------------------------------------------------------------
# SQL logging
# -----------------------------------------------------------------------------
HIBERNATE_FORMAT_SQL=true
HIBERNATE_SQL_LOG=debug
HIBERNATE_SQL_PARAM_LOG=trace

# -----------------------------------------------------------------------------
# CORS, mainly for browser/WebView local testing.
# Native Android HTTP clients such as Retrofit do not require CORS.
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:[*],http://127.0.0.1:[*],http://10.0.2.2:[*],http://192.168.*.*:[*]
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
